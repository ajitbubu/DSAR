# Local development only. Every value here is a dev placeholder and must never be used outside
# local/test. Compose falls back to these same defaults when .env is absent.
POSTGRES_SUPERUSER_PASSWORD=dev-postgres
IDP_MIGRATOR_PASSWORD=dev-migrator
IDP_APP_PASSWORD=dev-app
IDP_RELAY_PASSWORD=dev-relay
# 32 random bytes, base64. Dev only — the local key provider refuses to start outside local/test.
IDP_LOCAL_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
# Production key custody (D-3) is HashiCorp Vault Transit. Uncomment to try it locally,
# then run `make vault-provision`.
# IDP_KEY_PROVIDER=vault
# IDP_VAULT_ADDR=http://vault:8200
# IDP_VAULT_TOKEN=dev-root-token
IDP_BFF_SHARED_SECRET=dev-bff-shared-secret-change-me-0123456789
